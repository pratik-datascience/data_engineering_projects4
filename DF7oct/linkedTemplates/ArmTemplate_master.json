{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF7oct"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureBlobStorage2P1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage2P1'"
		},
		"LSAzureBlobStorageP1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LSAzureBlobStorageP1'"
		},
		"LSPostgreSqlSinkP1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LSPostgreSqlSinkP1'"
		},
		"LSPostgreSqlSinkP1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "postgre7oct.postgres.database.azure.com"
		},
		"LSPostgreSqlSinkP1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"LSPostgreSqlSinkP1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgre7oct"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DF7oct_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureBlobStorage2P1_connectionString": {
						"value": "[parameters('AzureBlobStorage2P1_connectionString')]"
					},
					"LSAzureBlobStorageP1_connectionString": {
						"value": "[parameters('LSAzureBlobStorageP1_connectionString')]"
					},
					"LSPostgreSqlSinkP1_password": {
						"value": "[parameters('LSPostgreSqlSinkP1_password')]"
					},
					"LSPostgreSqlSinkP1_properties_typeProperties_server": {
						"value": "[parameters('LSPostgreSqlSinkP1_properties_typeProperties_server')]"
					},
					"LSPostgreSqlSinkP1_properties_typeProperties_database": {
						"value": "[parameters('LSPostgreSqlSinkP1_properties_typeProperties_database')]"
					},
					"LSPostgreSqlSinkP1_properties_typeProperties_username": {
						"value": "[parameters('LSPostgreSqlSinkP1_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}